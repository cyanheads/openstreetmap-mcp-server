# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # stateless | stateful | auto (auto resolves to stateful). HTTP only.
                                    # Set here rather than left to the schema default: this server keeps no
                                    # per-session state and never asks the client for input. An empty value
                                    # or an unsubstituted ${…} placeholder reads as unset.
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_TOOL_FAILURE_PAYLOADS=false   # Log each failed call's arguments and result, redacted by key name only
                                    # (a secret inside a free-form value is logged). Default: false.
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Cap per logged payload, in UTF-8 bytes

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP base URL (e.g., http://localhost:4318); traces and metrics go to <base>/v1/traces and /v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # OTLP logs URL (e.g., http://localhost:4318/v1/logs); the only switch for log export

# ── Server-specific ──────────────────────────────────────────────────
# OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org  # Override for private/mirror instance
# OSM_USER_AGENT=my-map-app                                # Custom application identifier required by Nominatim usage policy
                                                          # When unset, defaults to openstreetmap-mcp-server/<package version>.
# OSM_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter  # Pins one endpoint and disables failover; sized by OSM_OVERPASS_MAX_CONCURRENCY, no |N suffix
# OSM_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter  # Ordered failover list; add a mirror to enable failover (check its usage policy, data coverage, and freshness first)
                                                          # Append |N to a mirror (…/interpreter|4) to give it N slots and add capacity; unsuffixed it is failover only. Write a | inside a URL as %7C.
# OSM_OVERPASS_MAX_CONCURRENCY=2     # Concurrent Overpass submissions per endpoint without |N; match the endpoint's /api/status slot budget. Queries wait at most 30 s for a slot.
