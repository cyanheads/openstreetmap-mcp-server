{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "openstreetmap-mcp-server",
  "version": "0.4.8",
  "description": "Geocode, reverse geocode, and run Overpass spatial queries on OpenStreetMap data via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/openstreetmap-mcp-server#readme",
  "repository": "https://github.com/cyanheads/openstreetmap-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "openstreetmap",
    "geocoding",
    "nominatim",
    "overpass"
  ],
  "mcpServers": {
    "openstreetmap-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/openstreetmap-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
